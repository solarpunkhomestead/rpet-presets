{
  "name": "rpet-presets",
  "version": "0.0.0",
  "description": "rPET presets",
  "author": "Sean Marquez",
  "license": "CC0-1.0",
  "packageManager": "npm",
  "workspaces": [
    "./packages/*",
    "./packages/@*/*"
  ],
  "m30pm": {
    "versionControlTool": "git",
    "buildTool": "gradle",
    "loggingLevel": "error"
  },
  "dependencies": {
    "@rse/nunjucks-cli": "1.5.3",
    "yaml-datastore": "^0.1.0-alpha.3"
  },
  "scripts": {
    "build": "npm run clean && ./gradlew --offline build",
    "clean": "./gradlew --offline clean",
    "readme": "nunjucks -d package.json views/README.md.njk > README.md"
  }
}
