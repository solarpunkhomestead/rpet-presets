{
  "name": "rpet-presets",
  "version": "0.0.0",
  "description": "Demo m30ml project for modeling 3D printer slicer presets for recycled PET (rPET)",
  "author": "Sean Marquez",
  "license": "CC0-1.0",
  "packageManager": "npm",
  "repository": {
    "type": "git",
    "url": "https://github.com/solarpunkhomestead/rpet-presets.git"
  },
  "workspaces": [
    "./packages/*",
    "./packages/@*/*"
  ],
  "m30pm": {
    "versionControlTool": "git",
    "buildTool": "gradle",
    "loggingLevel": "error"
  },
  "dependencies": {
    "@rse/nunjucks-cli": "1.5.3",
    "yaml-datastore": "^0.1.0-alpha.3"
  },
  "scripts": {
    "build": "npm run clean && ./gradlew --offline build",
    "tree": "./gradlew generateBuildTree",
    "clean": "./gradlew --offline clean",
    "readme": "nunjucks -d package.json views/README.md.njk > .readme.md && markedpp .readme.md > README.md && rm .readme.md"
  }
}
